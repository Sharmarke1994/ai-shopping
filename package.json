{
  "name": "ai-shopping",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/run-database-migrations.ts",
    "harness:v0-05": "tsx scripts/run-v0-05-harness.ts",
    "harness:v0-06": "tsx scripts/run-v0-06-retrieval-spike.ts",
    "proof:v0-06:persisted-live": "tsx scripts/run-v0-06-persisted-retrieval-proof.ts",
    "proof:v0-07:live": "tsx scripts/run-v0-07-founder-proof.ts",
    "proof:v0-08:live": "tsx scripts/run-v0-08-founder-proof.ts",
    "proof:v0-09:live": "tsx scripts/run-v0-09-founder-proof.ts",
    "proof:v0-09:recovery-rc1:live": "tsx scripts/run-v0-09-recovery-rc1-founder-proof.ts",
    "proof:v0-09:recovery-rc2:live": "tsx scripts/run-v0-09-recovery-rc2-founder-proof.ts",
    "proof:v0-09:recovery-rc3:live": "tsx scripts/run-v0-09-recovery-rc3-founder-proof.ts",
    "test:v0-09:recovery-rc3-oracle": "V0_09_RC3_ORACLE_SELF_TEST=1 tsx scripts/run-v0-09-recovery-rc3-founder-proof.ts",
    "diagnostic:v0-09:recovery-rc2:pages": "tsx scripts/run-v0-09-recovery-rc2-page-soak.ts",
    "diagnostic:v0-09:recovery-rc2:understanding": "tsx scripts/run-v0-09-recovery-rc2-understanding-diagnostic.ts",
    "diagnostic:v0-09:recovery-rc2:destinations": "tsx scripts/run-v0-09-recovery-rc2-destination-diagnostic.ts",
    "diagnostic:v0-09:recovery-rc3:context": "CONTEXT_HARDENING_CASE_SET=rc3 CONTEXT_HARDENING_OUTPUT_STEM=v0-09-recovery-rc3-context-precheck tsx scripts/run-v0-05-context-hardening-diagnostic.ts",
    "eval:v0-05:live": "tsx scripts/run-v0-05-live-eval.ts",
    "diagnostic:v0-05:context-hardening": "tsx scripts/run-v0-05-context-hardening-diagnostic.ts",
    "screenshots:v0-02": "node scripts/capture-v0-02-screenshots.mjs",
    "screenshots:v0-07": "node scripts/capture-v0-07-screenshots.mjs",
    "screenshots:v0-08": "node scripts/capture-v0-08-screenshots.mjs",
    "screenshots:v0-09": "pnpm build && node scripts/capture-v0-09-screenshots.mjs",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "prettier --check . && eslint . --max-warnings=0 && next typegen && tsc --noEmit && vitest run && next build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "drizzle-orm": "^0.45.2",
    "ipaddr.js": "^2.5.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "parse5": "^8.0.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.19.0"
}
