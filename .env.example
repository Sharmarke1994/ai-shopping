# V0-01 and the fixture-driven UI do not require external credentials.
# Populate a service only when exercising its live adapter.

OPENAI_API_KEY=
# Optional; defaults to the V0-05 release-eval model.
OPENAI_CONTEXT_MODEL=gpt-5.6-terra
DATABASE_URL=
DIRECT_DATABASE_URL=
TEST_DATABASE_URL=

# V0-10 Spaces: a durable, canonical absolute directory OUTSIDE the source tree.
# Use a non-temporary directory for personal rooms; never commit uploaded photos.
CONSIDER_SPACE_ASSET_DIR=
# Leave off normally. Fictional analysis only, guarded to a local test database.
CONSIDER_SPACE_FIXTURE_MODE=0
